---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

// Each photo gets its own full-screen 12×12 frame, drawn on a canvas by
// grid.js. Order and placement are randomized on each page load.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  ["../assets/trail/*.jpg", "!../assets/trail/58.jpg"],
  { eager: true },
);

// Image widths from the narrowest span on a phone (3 of 6 columns ≈ 200px,
// 400px at 2×) to the widest on a large desktop (6 of 12 columns ≈ 800px,
// 1600px at 2×). grid.js draws each photo from the smallest source that
// covers its span at the screen's pixel density.
const WIDTHS = [400, 800, 1200, 1600, 2400];
const photoData = await Promise.all(
  Object.values(photos).map(async ({ default: src }) => {
    const widths = WIDTHS.filter((width) => width < src.width).concat(
      src.width,
    );
    const image = await getImage({ src, widths, format: "webp" });
    return {
      width: src.width,
      height: src.height,
      sources: image.srcSet.values.map(({ url, descriptor }) => ({
        url,
        width: parseInt(descriptor!),
      })),
    };
  }),
);
---

<svg
  class="Grid__seal"
  data-seal
  viewBox="0 0 500 500"
  role="img"
  aria-label="Black Mountain School, Black Mountain N.C."
>
  <!-- Glyphs are added by seal.js -->
  <g class="Grid__seal-text" data-seal-text></g>
</svg>
<!-- The whole photo stack, redrawn from the scroll position -->
<canvas class="Grid__canvas" data-canvas aria-hidden="true"></canvas>
<div class="Grid__frames" data-frames data-photos={JSON.stringify(photoData)}>
  <!-- One screen of scroll per frame placed so far -->
  <div class="Grid__track" data-track></div>
</div>

<script src="../scripts/grid.js"></script>
<script src="../scripts/seal.js"></script>

<style lang="scss" scoped>
  @import url("https://fonts.googleapis.com/css2?family=Oranienbaum&display=block");

  :root {
    --bg: #f6f6f6;
    --color: black;
  }

  :global(html),
  :global(body) {
    background: var(--bg);
    // Hide the scrollbar but keep scrolling (Firefox, then WebKit/Chromium)
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .Grid__seal {
    --scale: 1;
    position: fixed;
    top: 50%;
    left: 50%;
    // --seal-rotation is driven by scroll (see seal.js)
    transform: translate(-50%, -50%) rotate(var(--seal-rotation, 0deg))
      scale(var(--scale));
    display: block;
    width: min(80vw, 80vh);
    height: auto;
    z-index: 1;

    @media (min-width: 768px) {
      --scale: 0.9;
    }
  }

  .Grid__seal-text {
    font-family: Oranienbaum, serif;
    font-weight: 400;
    font-size: 50px;
    text-anchor: middle;
    fill: var(--color);
    // Ink spread: thickens the strokes like letterpress
    stroke: var(--color);
    stroke-width: 2.5px;
    stroke-linejoin: round;
  }

  // Fixed under the seal; grid.js sizes its pixels to the viewport
  .Grid__canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  // The first frame starts ~90svh down to hint at scrolling.
  .Grid__frames {
    // Columns and rows per frame, read by grid.js
    --grid: 12;
    padding-top: 90svh;

    @media (max-width: 768px) {
      --grid: 6;
    }
  }

  // Gives the page its scroll length: one full-screen frame step per placed
  // frame (--count is set by grid.js)
  .Grid__track {
    height: calc(var(--count, 0) * 100svh);
  }
</style>
