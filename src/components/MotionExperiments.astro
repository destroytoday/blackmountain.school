---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

// Black Mountain College photos for the image trail (P), served small.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/trail/*.jpg",
  { eager: true },
);
const trail = await Promise.all(
  Object.values(photos).map(async ({ default: src }) => {
    const image = await getImage({ src, width: 480, format: "webp" });
    return { src: image.src, ratio: src.width / src.height };
  }),
);
---

<section
  class="MotionExperiments"
  data-motion-experiments
  role="button"
  tabindex="0"
  aria-label="Black Mountain School animation. Tap or press Space for another, drag to draw."
>
  <div class="MotionExperiments__art" data-motion-art>
    <canvas
      class="MotionExperiments__canvas"
      data-motion-gpu
      aria-hidden="true"
    ></canvas>
    <canvas
      class="MotionExperiments__canvas"
      data-motion-ink
      aria-hidden="true"
    ></canvas>
    <canvas
      class="MotionExperiments__canvas"
      data-motion-xerox
      aria-hidden="true"
      style="visibility: hidden"
    ></canvas>
  </div>
  <div
    class="MotionExperiments__trail"
    data-trail={JSON.stringify(trail)}
    aria-hidden="true"
  ></div>
  <canvas
    class="MotionExperiments__marker"
    data-marker
    aria-hidden="true"
  ></canvas>
</section>

<script src="../scripts/experiments.js"></script>
<script src="../scripts/marker.js"></script>
<script src="../scripts/trail.js"></script>

<style lang="scss" scoped>
  @font-face {
    font-family: Bodoni;
    src: url("../assets/fonts/bodoni-moda-seal.woff2") format("woff2");
    font-weight: 700;
    font-display: block;
  }

  :global(html),
  :global(body) {
    background: #000;
    overflow: hidden;
    overscroll-behavior: none;
  }

  .MotionExperiments {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    outline: none;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    background: #000;
    transition: filter 0.3s ease;

    &.is-inverted {
      filter: invert(1);
    }
  }

  .MotionExperiments__art {
    position: relative;
    width: min(100vw, 100vh);
    height: min(100vw, 100vh);
    width: min(100vw, 100dvh);
    height: min(100vw, 100dvh);
  }

  .MotionExperiments__trail {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;

    :global(img) {
      position: absolute;
      left: 0;
      top: 0;
      width: clamp(140px, 22vmin, 280px);
      height: auto;
      max-width: none;
      opacity: 0;
      will-change: transform, opacity;
    }
  }

  .MotionExperiments__marker {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mix-blend-mode: difference;
  }

  .MotionExperiments__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
